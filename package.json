{
  "name": "production-log-mining-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:mock": "ng serve --configuration mock",
    "api": "tsx server/index.ts",
    "api:watch": "tsx watch server/index.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:api:watch\" \"npm:web\"",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "serve": "ng build && tsx server/index.ts",
    "web": "ng serve --proxy-config proxy.conf.json",
    "cluster:freq": "tsx scripts/cluster-frequency.ts",
    "backfill": "tsx scripts/backfill-occurrences.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "dotenv": "^18.0.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
